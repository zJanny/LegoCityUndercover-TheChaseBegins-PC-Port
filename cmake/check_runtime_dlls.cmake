cmake_minimum_required(VERSION 3.19)
include("${CMAKE_CURRENT_LIST_DIR}/windows_dll_scan.cmake")

foreach(variable PROGRAM_LIST OBJDUMP DESTINATION)
  if(NOT DEFINED ${variable})
    message(FATAL_ERROR "check_runtime_dlls.cmake: ${variable} is not set")
  endif()
endforeach()
if("$ENV{SystemRoot}" STREQUAL "")
  message(FATAL_ERROR "SystemRoot is not set, so the Windows system DLLs cannot be told apart")
endif()

file(GLOB copied_dlls "${DESTINATION}/*.dll")
file(STRINGS "${PROGRAM_LIST}" listed)
set(files)
foreach(file IN LISTS listed copied_dlls)
  if(NOT file STREQUAL "" AND EXISTS "${file}")
    list(APPEND files "${file}")
  endif()
endforeach()
list(REMOVE_DUPLICATES files)
list(LENGTH files file_count)
if(file_count EQUAL 0)
  message(FATAL_ERROR "${PROGRAM_LIST} lists no built program")
endif()

chase_imported_dll_names("${files}" "${OBJDUMP}" "" imported)
set(absent)
foreach(name IN LISTS imported)
  chase_is_windows_dll("${name}" system)
  if(NOT system AND NOT EXISTS "${DESTINATION}/${name}")
    list(APPEND absent "${name}")
  endif()
endforeach()
if(absent)
  list(JOIN absent ", " names)
  message(FATAL_ERROR "These imported DLLs are not in ${DESTINATION}: ${names}")
endif()
list(LENGTH imported import_count)
message(STATUS "${file_count} programs and DLLs import ${import_count} DLLs: every imported DLL is in the build folder or is a Windows DLL")
