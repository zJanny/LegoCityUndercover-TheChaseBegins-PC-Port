if(NOT DEFINED ENV{APPDATA} OR "$ENV{APPDATA}" STREQUAL "")
  message(FATAL_ERROR "APPDATA is not set in the environment of the test")
endif()
file(TO_CMAKE_PATH "$ENV{APPDATA}" appdata)
file(TO_CMAKE_PATH "${BUILD_DIR}" build_dir)
string(FIND "${appdata}/" "${build_dir}/test-xdg/" position)
if(NOT position EQUAL 0)
  message(FATAL_ERROR "APPDATA of the test is ${appdata}, outside ${build_dir}/test-xdg")
endif()
