find_package(PkgConfig REQUIRED)
pkg_check_modules(SDL2 REQUIRED IMPORTED_TARGET sdl2)
# Every program keeps its own main() and console: SDL2main, its mingw32 ordering entry and -mwindows are dropped where sdl2.pc lists them.
get_target_property(CHASE_SDL2_LIBRARIES PkgConfig::SDL2 INTERFACE_LINK_LIBRARIES)
if(CHASE_SDL2_LIBRARIES)
  list(FILTER CHASE_SDL2_LIBRARIES EXCLUDE REGEX "(^|[/\\\\]|-l)(lib)?(SDL2main|mingw32)(\\.a|\\.lib)?$")
  set_target_properties(PkgConfig::SDL2 PROPERTIES INTERFACE_LINK_LIBRARIES "${CHASE_SDL2_LIBRARIES}")
endif()
get_target_property(CHASE_SDL2_LINK_OPTIONS PkgConfig::SDL2 INTERFACE_LINK_OPTIONS)
if(CHASE_SDL2_LINK_OPTIONS)
  list(REMOVE_ITEM CHASE_SDL2_LINK_OPTIONS -mwindows)
  set_target_properties(PkgConfig::SDL2 PROPERTIES INTERFACE_LINK_OPTIONS "${CHASE_SDL2_LINK_OPTIONS}")
endif()
get_target_property(CHASE_SDL2_COMPILE_OPTIONS PkgConfig::SDL2 INTERFACE_COMPILE_OPTIONS)
if(CHASE_SDL2_COMPILE_OPTIONS)
  list(REMOVE_ITEM CHASE_SDL2_COMPILE_OPTIONS -Dmain=SDL_main)
  set_target_properties(PkgConfig::SDL2 PROPERTIES INTERFACE_COMPILE_OPTIONS "${CHASE_SDL2_COMPILE_OPTIONS}")
endif()
set_property(TARGET PkgConfig::SDL2 APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS SDL_MAIN_HANDLED)
