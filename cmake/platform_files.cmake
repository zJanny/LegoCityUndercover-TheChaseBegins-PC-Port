if(WIN32)
  set(CHASE_PLATFORM windows)
else()
  set(CHASE_PLATFORM posix)
endif()
message(STATUS "Platform files: *_${CHASE_PLATFORM}.cpp")

function(chase_platform_skip_test name reason)
  add_test(NAME ${name} COMMAND ${CMAKE_COMMAND} -E echo "SKIPPED on ${CHASE_PLATFORM}: ${reason}")
  set_tests_properties(${name} PROPERTIES SKIP_REGULAR_EXPRESSION "SKIPPED on ${CHASE_PLATFORM}: ")
endfunction()

function(chase_link_compiler_runtime_statically target)
  if(MINGW)
    target_link_options(${target} PRIVATE -static)
  endif()
endfunction()

function(chase_all_tests directory out)
  get_property(tests DIRECTORY ${directory} PROPERTY TESTS)
  set(found)
  foreach(test IN LISTS tests)
    list(APPEND found "${directory}|${test}")
  endforeach()
  get_property(subdirectories DIRECTORY ${directory} PROPERTY SUBDIRECTORIES)
  foreach(subdirectory IN LISTS subdirectories)
    chase_all_tests(${subdirectory} below)
    list(APPEND found ${below})
  endforeach()
  set(${out} ${found} PARENT_SCOPE)
endfunction()

function(chase_use_hidden_window_for_gl_tests directory)
  chase_all_tests(${directory} entries)
  foreach(entry IN LISTS entries)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 test_directory)
    list(GET parts 1 test)
    set_property(TEST ${test} DIRECTORY ${test_directory} APPEND PROPERTY SKIP_REGULAR_EXPRESSION "no OpenGL 4.6 context")
    get_property(environment TEST ${test} DIRECTORY ${test_directory} PROPERTY ENVIRONMENT)
    if("SDL_VIDEODRIVER=offscreen" IN_LIST environment)
      list(TRANSFORM environment REPLACE "^SDL_VIDEODRIVER=offscreen$" "SDL_VIDEODRIVER=windows")
      string(FIND "${environment}" "CHASE_HIDDEN_WINDOW=" given)
      if(given EQUAL -1)
        list(APPEND environment "CHASE_HIDDEN_WINDOW=1")
      endif()
      set_property(TEST ${test} DIRECTORY ${test_directory} PROPERTY ENVIRONMENT ${environment})
    endif()
  endforeach()
endfunction()

function(chase_isolate_test_appdata directory)
  chase_all_tests(${directory} entries)
  foreach(entry IN LISTS entries)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 test_directory)
    list(GET parts 1 test)
    get_property(environment TEST ${test} DIRECTORY ${test_directory} PROPERTY ENVIRONMENT)
    if("${environment}" MATCHES "(^|;)APPDATA=")
      message(FATAL_ERROR "The test ${test} sets APPDATA itself; every test gets its own folder under test-xdg")
    endif()
    set_property(TEST ${test} DIRECTORY ${test_directory} APPEND PROPERTY ENVIRONMENT "APPDATA=${CMAKE_BINARY_DIR}/test-xdg/${test}")
  endforeach()
endfunction()
