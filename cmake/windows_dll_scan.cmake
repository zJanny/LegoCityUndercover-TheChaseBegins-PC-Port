# The names of the DLLs that one file imports (its import table), read with objdump.
function(chase_file_imports file objdump out)
  execute_process(COMMAND "${objdump}" -p "${file}" OUTPUT_VARIABLE text ERROR_VARIABLE error_text RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${objdump} -p failed (${result}) on ${file}: ${error_text}")
  endif()
  string(REGEX MATCHALL "DLL Name: [^\r\n;]+" lines "${text}")
  set(names)
  foreach(line IN LISTS lines)
    string(SUBSTRING "${line}" 10 -1 name)
    string(STRIP "${name}" name)
    list(APPEND names "${name}")
  endforeach()
  set(${out} "${names}" PARENT_SCOPE)
endfunction()

# Names of the DLLs that the files import, without duplicates in any letter case. Reading the import table of a big DLL takes long, so a
# non-empty cache file keeps the names of each file with its size and time and reads only the files that changed.
function(chase_imported_dll_names files objdump cache_file out)
  set(kept_text)
  if(NOT cache_file STREQUAL "" AND EXISTS "${cache_file}")
    file(STRINGS "${cache_file}" cache_lines)
    foreach(line IN LISTS cache_lines)
      string(REPLACE "|" ";" fields "${line}")
      list(GET fields 0 cached_file)
      list(GET fields 1 cached_size)
      list(GET fields 2 cached_time)
      list(LENGTH fields field_count)
      set(cached_names)
      if(field_count GREATER 3)
        list(GET fields 3 cached_names)
        string(REPLACE "," ";" cached_names "${cached_names}")
      endif()
      set("chase_cache_${cached_file}" "${cached_size}|${cached_time}|${cached_names}")
      if(NOT cached_file IN_LIST files)
        string(APPEND kept_text "${line}\n")
      endif()
    endforeach()
  endif()
  set(names)
  set(keys)
  set(cache_text "${kept_text}")
  foreach(file IN LISTS files)
    file(SIZE "${file}" size)
    file(TIMESTAMP "${file}" time "%Y%m%d%H%M%S")
    set(file_names)
    set(hit FALSE)
    if(DEFINED "chase_cache_${file}")
      string(REGEX MATCH "^([0-9]+)[|]([0-9]+)[|](.*)$" ignored "${chase_cache_${file}}")
      if(CMAKE_MATCH_1 STREQUAL size AND CMAKE_MATCH_2 STREQUAL time)
        set(file_names "${CMAKE_MATCH_3}")
        set(hit TRUE)
      endif()
    endif()
    if(NOT hit)
      chase_file_imports("${file}" "${objdump}" file_names)
    endif()
    string(REPLACE ";" "," joined "${file_names}")
    string(APPEND cache_text "${file}|${size}|${time}|${joined}\n")
    foreach(name IN LISTS file_names)
      string(TOLOWER "${name}" key)
      if(NOT key IN_LIST keys)
        list(APPEND keys "${key}")
        list(APPEND names "${name}")
      endif()
    endforeach()
  endforeach()
  if(NOT cache_file STREQUAL "")
    file(WRITE "${cache_file}" "${cache_text}")
  endif()
  set(${out} "${names}" PARENT_SCOPE)
endfunction()

# True for the DLLs of Windows itself: the API set names and everything the system folder holds.
function(chase_is_windows_dll name out)
  set(${out} FALSE PARENT_SCOPE)
  if(name MATCHES "^(api|ext)-ms-")
    set(${out} TRUE PARENT_SCOPE)
  elseif(EXISTS "$ENV{SystemRoot}/System32/${name}")
    set(${out} TRUE PARENT_SCOPE)
  endif()
endfunction()

# Every non-system DLL that the files import, transitively, as a path inside one of the search folders. Names in built_names are DLLs of the
# build itself (lowercase) and stay where they are. DLLs found in no search folder come back in missing.
function(chase_collect_dll_sources files search_folders objdump cache_file built_names sources_out missing_out)
  if("$ENV{SystemRoot}" STREQUAL "")
    message(FATAL_ERROR "SystemRoot is not set, so the Windows system DLLs cannot be told apart")
  endif()
  set(sources)
  set(missing)
  set(known ${built_names})
  set(queue ${files})
  while(queue)
    chase_imported_dll_names("${queue}" "${objdump}" "${cache_file}" names)
    set(queue)
    foreach(name IN LISTS names)
      string(TOLOWER "${name}" key)
      if(key IN_LIST known)
        continue()
      endif()
      list(APPEND known "${key}")
      chase_is_windows_dll("${name}" system)
      if(system)
        continue()
      endif()
      set(path)
      foreach(search_folder IN LISTS search_folders)
        if(EXISTS "${search_folder}/${name}")
          set(path "${search_folder}/${name}")
          break()
        endif()
      endforeach()
      if("${path}" STREQUAL "")
        list(APPEND missing "${name}")
      else()
        list(APPEND sources "${path}")
        list(APPEND queue "${path}")
      endif()
    endforeach()
  endwhile()
  set(${sources_out} "${sources}" PARENT_SCOPE)
  set(${missing_out} "${missing}" PARENT_SCOPE)
endfunction()
