function(chase_embed_utf8_manifest directory)
  get_property(targets DIRECTORY ${directory} PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(type ${target} TYPE)
    if(type STREQUAL "EXECUTABLE")
      target_sources(${target} PRIVATE $<TARGET_OBJECTS:chase_utf8_manifest>)
    endif()
  endforeach()
  get_property(subdirectories DIRECTORY ${directory} PROPERTY SUBDIRECTORIES)
  foreach(subdirectory IN LISTS subdirectories)
    chase_embed_utf8_manifest(${subdirectory})
  endforeach()
endfunction()

function(chase_add_utf8_path_tests)
  if(NOT BUILD_TESTING OR NOT TARGET chase-input-lab)
    return()
  endif()
  if(NOT WIN32)
    chase_platform_skip_test(utf8-path-argument "the Linux programs read UTF-8 paths unchanged; the manifest of cmake/windows_utf8.cmake is Windows only")
    return()
  endif()
  set(folder "${CMAKE_BINARY_DIR}/utf8-path-argument/Zuerich-Ж-日本")
  add_test(NAME utf8-path-prepare COMMAND ${CMAKE_COMMAND} -E make_directory "${folder}")
  add_test(NAME utf8-path-copy COMMAND ${CMAKE_COMMAND} -E copy "${CMAKE_BINARY_DIR}/config/controls.cfg" "${folder}/controls.cfg")
  add_test(NAME utf8-path-cleanup COMMAND ${CMAKE_COMMAND} -E remove_directory "${CMAKE_BINARY_DIR}/utf8-path-argument")
  set_tests_properties(utf8-path-prepare PROPERTIES FIXTURES_SETUP utf8_path_folder)
  set_tests_properties(utf8-path-copy PROPERTIES FIXTURES_SETUP utf8_path_folder DEPENDS utf8-path-prepare)
  set_tests_properties(utf8-path-cleanup PROPERTIES FIXTURES_CLEANUP utf8_path_folder)
  add_test(NAME utf8-path-argument COMMAND chase-input-lab --smoke-test --config "${folder}/controls.cfg")
  add_test(NAME utf8-path-argument-missing COMMAND chase-input-lab --smoke-test --config "${folder}/missing.cfg")
  set_tests_properties(utf8-path-argument utf8-path-argument-missing PROPERTIES
    ENVIRONMENT "SDL_VIDEODRIVER=dummy" FIXTURES_REQUIRED utf8_path_folder)
  set_tests_properties(utf8-path-argument PROPERTIES PASS_REGULAR_EXPRESSION "SDL dummy input smoke test passed")
  set_tests_properties(utf8-path-argument-missing PROPERTIES
    PASS_REGULAR_EXPRESSION "Input laboratory: Cannot open controls: [^\n]*Zuerich-Ж-日本[^\n]*missing\\.cfg")
endfunction()

if(WIN32)
  if(CMAKE_VERSION VERSION_LESS 3.19)
    message(FATAL_ERROR "Building on Windows needs CMake 3.19 or newer")
  endif()
  enable_language(RC)
  add_library(chase_utf8_manifest OBJECT cmake/windows_utf8.rc)
  set_source_files_properties(cmake/windows_utf8.rc PROPERTIES OBJECT_DEPENDS ${CMAKE_CURRENT_LIST_DIR}/windows_utf8.manifest)
  target_include_directories(chase_utf8_manifest PRIVATE ${CMAKE_CURRENT_LIST_DIR})
  cmake_language(DEFER DIRECTORY ${CMAKE_SOURCE_DIR} CALL chase_embed_utf8_manifest ${CMAKE_SOURCE_DIR})
endif()
if(NOT CMAKE_VERSION VERSION_LESS 3.19)
  cmake_language(DEFER DIRECTORY ${CMAKE_SOURCE_DIR} CALL chase_add_utf8_path_tests)
endif()
