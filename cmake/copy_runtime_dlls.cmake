cmake_minimum_required(VERSION 3.19)
include("${CMAKE_CURRENT_LIST_DIR}/windows_dll_scan.cmake")

foreach(variable PROGRAM_LIST SEARCH_FOLDERS OBJDUMP DESTINATION STAMP DEPFILE)
  if(NOT DEFINED ${variable})
    message(FATAL_ERROR "copy_runtime_dlls.cmake: ${variable} is not set")
  endif()
endforeach()

file(STRINGS "${PROGRAM_LIST}" listed)
set(programs)
set(built_names)
foreach(program IN LISTS listed)
  if(NOT program STREQUAL "" AND EXISTS "${program}")
    list(APPEND programs "${program}")
    get_filename_component(name "${program}" NAME)
    string(TOLOWER "${name}" name)
    list(APPEND built_names "${name}")
  endif()
endforeach()
if(NOT programs)
  message(FATAL_ERROR "${PROGRAM_LIST} lists no built program")
endif()

# DLLs that a library loads with LoadLibrary (sdl2-compat loads SDL3.dll) are in no import table. Those present in a searched folder are
# copied and scanned like the imported ones; a name that no searched folder holds is not needed by this setup.
set(loaded_dlls)
foreach(name IN LISTS RUNTIME_LOADED)
  foreach(search_folder IN LISTS SEARCH_FOLDERS)
    if(EXISTS "${search_folder}/${name}")
      list(APPEND loaded_dlls "${search_folder}/${name}")
      break()
    endif()
  endforeach()
endforeach()

chase_collect_dll_sources("${programs};${loaded_dlls}" "${SEARCH_FOLDERS}" "${OBJDUMP}" "${DESTINATION}/runtime-dlls-imports.cache" "${built_names}" dlls missing)
if(missing)
  list(JOIN missing ", " names)
  message(FATAL_ERROR "The programs need DLLs that are in no folder searched (${SEARCH_FOLDERS}) and are not Windows DLLs: ${names}. Install the package that holds them.")
endif()
list(APPEND dlls ${loaded_dlls})
list(REMOVE_DUPLICATES dlls)
list(SORT dlls)

execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${dlls} "${DESTINATION}" RESULT_VARIABLE copied ERROR_VARIABLE copy_error)
if(NOT copied EQUAL 0)
  message(FATAL_ERROR "Copying the DLLs into ${DESTINATION} failed (is a program of the build still running?): ${copy_error}")
endif()

file(RELATIVE_PATH stamp_name "${DESTINATION}" "${STAMP}")
set(dependencies)
foreach(dll IN LISTS dlls)
  string(REPLACE " " "\\ " escaped "${dll}")
  string(APPEND dependencies " ${escaped}")
endforeach()
file(WRITE "${DEPFILE}" "${stamp_name}:${dependencies}\n")
list(LENGTH dlls count)
string(REPLACE ";" "\n" listing "${dlls}")
file(WRITE "${STAMP}" "${listing}\n")
message(STATUS "${count} DLLs are in ${DESTINATION}")
