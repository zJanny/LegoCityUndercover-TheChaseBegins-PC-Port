{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{"type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR}\"; ./.claude/run_hook.cmd pre-bash", "timeout": 180}]
      },
      {
        "matcher": "Agent",
        "hooks": [{"type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR}\"; ./.claude/run_hook.cmd pre-agent", "timeout": 10}]
      },
      {
        "matcher": "Read|Edit|Write|Glob|Grep",
        "hooks": [{"type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR}\"; ./.claude/run_hook.cmd pre-tool", "timeout": 10}]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{"type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR}\"; ./.claude/run_hook.cmd subagent-stop", "timeout": 10}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{"type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR}\"; ./.claude/run_hook.cmd post-edit", "timeout": 60}]
      }
    ]
  }
}
