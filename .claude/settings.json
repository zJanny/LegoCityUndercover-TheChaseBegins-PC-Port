{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/claude_hooks.py\" pre-bash", "timeout": 180}]
      },
      {
        "matcher": "Agent",
        "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/claude_hooks.py\" pre-agent", "timeout": 10}]
      },
      {
        "matcher": "Read|Edit|Write|Glob|Grep",
        "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/claude_hooks.py\" pre-tool", "timeout": 10}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/claude_hooks.py\" post-edit", "timeout": 60}]
      }
    ]
  }
}
