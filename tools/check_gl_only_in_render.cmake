file(GLOB_RECURSE sources "${SRC_DIR}/*.cpp" "${SRC_DIR}/*.hpp" "${SRC_DIR}/*.h")
set(glUse "(^|[^A-Za-z0-9_])(gl[A-Z][A-Za-z0-9]*\\(|GL[a-z][A-Za-z0-9]*|GL_[A-Z0-9_]+)")
set(offenders "")
foreach(file IN LISTS sources)
  file(RELATIVE_PATH relative "${SRC_DIR}" "${file}")
  if(relative MATCHES "^render/")
    continue()
  endif()
  file(READ "${file}" text)
  if(text MATCHES "<epoxy/" OR text MATCHES "${glUse}")
    list(APPEND offenders "${file}")
  endif()
endforeach()
if(offenders)
  string(REPLACE ";" "\n  " listing "${offenders}")
  message(FATAL_ERROR "OpenGL outside src/render:\n  ${listing}\nAll OpenGL calls, <epoxy/gl.h> and GL types live in src/render/ and are exposed through plain-type headers (CLAUDE.md, section Architecture rules; rule gl-only-in-render).")
endif()
