cmake_minimum_required(VERSION 3.16)

set(keepFiles render/front_presenter.cpp render/hud_overlay.cpp)
set(keepCounts 2 1)
set(swapFiles game.cpp game_front.hpp)
set(swapCounts 1 3)
set(swapExempt viewer.cpp fmv.cpp main.cpp)

set(problems "")
list(LENGTH keepFiles keepTotal)
math(EXPR keepLast "${keepTotal} - 1")
foreach(index RANGE ${keepLast})
  list(GET keepFiles ${index} relative)
  list(GET keepCounts ${index} expected)
  if(NOT EXISTS "${SRC_DIR}/${relative}")
    list(APPEND problems "${relative}: missing")
    continue()
  endif()
  file(READ "${SRC_DIR}/${relative}" text)
  string(REGEX MATCHALL "keepFrameIfRequested\\(" found "${text}")
  list(LENGTH found count)
  if(NOT count EQUAL expected)
    list(APPEND problems "${relative}: ${count} keepFrameIfRequested call(s), expected ${expected} (one per frame-ending function)")
  endif()
endforeach()

file(GLOB_RECURSE sources "${SRC_DIR}/*.cpp" "${SRC_DIR}/*.hpp")
foreach(file IN LISTS sources)
  file(RELATIVE_PATH relative "${SRC_DIR}" "${file}")
  if(relative IN_LIST swapExempt OR relative MATCHES "^render/")
    continue()
  endif()
  file(READ "${file}" text)
  string(REGEX MATCHALL "SDL_GL_SwapWindow\\(" found "${text}")
  list(LENGTH found count)
  set(expected 0)
  list(FIND swapFiles "${relative}" position)
  if(NOT position EQUAL -1)
    list(GET swapCounts ${position} expected)
  endif()
  if(NOT count EQUAL expected)
    list(APPEND problems "${relative}: ${count} SDL_GL_SwapWindow call(s), expected ${expected}")
  endif()
endforeach()

if(problems)
  string(REPLACE ";" "\n  " listing "${problems}")
  message(FATAL_ERROR "Frame-ending paths changed:\n  ${listing}\nEvery frame-ending function of src/render calls keepFrameIfRequested (picture behind the settings menu, QOLSET-98); a new frame end must keep the frame and be added to tools/check_frame_keep_points.cmake.")
endif()
