set(body "#include \"render/shaders.hpp\"\n\nnamespace chase::render::shaders {\n")
foreach(entry IN LISTS SHADERS)
  string(REPLACE ":" ";" parts "${entry}")
  list(GET parts 0 symbol)
  list(GET parts 1 file)
  file(READ "${SHADER_DIR}/${file}" text)
  string(APPEND body "const char* const ${symbol} = R\"GLSL(${text})GLSL\";\n")
endforeach()
string(APPEND body "}\n")
file(WRITE "${OUTPUT}.tmp" "${body}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}")
