file(GLOB_RECURSE sources "${SRC_DIR}/*.cpp" "${SRC_DIR}/*.hpp" "${SRC_DIR}/*.h")
set(offenders "")
foreach(file IN LISTS sources)
  file(READ "${file}" text)
  if(text MATCHES "#version [0-9]" OR text MATCHES "gl_Position" OR text MATCHES "gl_FragCoord")
    list(APPEND offenders "${file}")
  endif()
endforeach()
if(offenders)
  string(REPLACE ";" "\n  " listing "${offenders}")
  message(FATAL_ERROR "Shader source found in C++ files:\n  ${listing}\nShader code lives only in .glsl files under src/render/shaders/ (CLAUDE.md, section Architecture rules, Shaders).")
endif()
