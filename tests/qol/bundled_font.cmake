set(fontFile "${ROOT_DIR}/third_party/fonts/NotoSans-Regular.ttf")
set(licenceFile "${ROOT_DIR}/third_party/fonts/OFL.txt")
set(stbFile "${ROOT_DIR}/third_party/stb/stb_truetype.h")
set(reuseFile "${ROOT_DIR}/REUSE.toml")

foreach(file IN ITEMS "${fontFile}" "${licenceFile}" "${stbFile}" "${reuseFile}")
  if(NOT EXISTS "${file}")
    message(FATAL_ERROR "missing bundled file ${file}")
  endif()
endforeach()

function(expect_hash file expected)
  file(SHA256 "${file}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${file}: sha256 ${actual}, expected ${expected}")
  endif()
endfunction()

# Hashes recorded 2026-10-30 by 20261030-qolui-A with sha256sum over the files downloaded from the commits named in REUSE.toml.
expect_hash("${fontFile}" 478c558ea716033cd60c03438f628dfa75694dcf6b5f6d505a2f05fd2b4f3823)
expect_hash("${licenceFile}" cee9892f9f0cc8fe882c9e9537ee6a89621d86ee7ceaf70b02e2b2b1c25c061a)
expect_hash("${stbFile}" ecd30b05e0dd4fea3a13c26810dd9e1992dc379049482c393d5a19e6b5090aab)

file(READ "${licenceFile}" licence)
if(NOT licence MATCHES "SIL Open Font License, Version 1.1")
  message(FATAL_ERROR "OFL.txt does not contain the SIL Open Font License 1.1")
endif()

file(READ "${reuseFile}" reuse)
foreach(path IN ITEMS "third_party/fonts/NotoSans-Regular.ttf" "third_party/fonts/OFL.txt" "third_party/stb/stb_truetype.h")
  string(FIND "${reuse}" "path = \"${path}\"" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "REUSE.toml has no entry for ${path}")
  endif()
endforeach()
foreach(commit IN ITEMS 28b15b4b43b7bed62b5cf6e6b0b5ff5846270535 4bc63d7ebca1faed49c6c685f380ba0abc2c1941 6e9f34d5429cf16790ec43c9bac3f1ee4ad1f760)
  string(FIND "${reuse}" "${commit}" position)
  if(position EQUAL -1)
    message(FATAL_ERROR "REUSE.toml does not record commit ${commit}")
  endif()
endforeach()
