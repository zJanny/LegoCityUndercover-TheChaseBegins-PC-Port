set(hookListFile "${ROOT_DIR}/docs/plans/features/qol-settings-menu-hooks.md")
set(qolUse "(^|[^A-Za-z0-9_])qol::|chase_qol")
set(qolInclude "^[ \t]*#[ \t]*include[ \t]*[<\"][^>\"]*qol/")
set(problems "")

function(split_lines text out)
  string(REPLACE ";" "<SEMI>" text "${text}")
  string(REPLACE "[" "<LB>" text "${text}")
  string(REPLACE "]" "<RB>" text "${text}")
  string(REPLACE "\n" ";" text "${text}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

if(NOT EXISTS "${hookListFile}")
  message(FATAL_ERROR "qol-separation: hook list file missing: ${hookListFile}")
endif()
file(READ "${hookListFile}" featureText)
string(FIND "${featureText}" "### Hook points" hookStart)
if(hookStart EQUAL -1)
  message(FATAL_ERROR "qol-separation: no '### Hook points' section in ${hookListFile}")
endif()
string(SUBSTRING "${featureText}" ${hookStart} -1 hookSection)
string(REGEX REPLACE "^### Hook points[^\n]*\n" "" hookSection "${hookSection}")
string(REGEX REPLACE "\n#+ .*$" "" hookSection "${hookSection}")
split_lines("${hookSection}" hookLines)
set(listedFiles "")
foreach(line IN LISTS hookLines)
  if(line MATCHES "^- ")
    string(REGEX REPLACE "^- " "" entry "${line}")
    string(REPLACE "," ";" fields "${entry}")
    list(LENGTH fields fieldCount)
    if(NOT fieldCount EQUAL 4)
      list(APPEND problems "${hookListFile}: hook list entry needs file, function, hook, toggle: ${line}")
      continue()
    endif()
    list(GET fields 0 hookFile)
    string(STRIP "${hookFile}" hookFile)
    string(REPLACE "`" "" hookFile "${hookFile}")
    list(APPEND listedFiles "${hookFile}")
  endif()
endforeach()

file(GLOB_RECURSE codeFiles "${ROOT_DIR}/src/*.cpp" "${ROOT_DIR}/src/*.hpp" "${ROOT_DIR}/src/*.h" "${ROOT_DIR}/tests/*.cpp" "${ROOT_DIR}/tests/*.hpp" "${ROOT_DIR}/tests/*.h")
set(foundFiles "")
foreach(file IN LISTS codeFiles)
  file(RELATIVE_PATH relative "${ROOT_DIR}" "${file}")
  if(relative MATCHES "^tests/qol/" OR relative MATCHES "^tests/qol_separation_fixtures/" OR relative MATCHES "^src/qol/")
    continue()
  endif()
  file(READ "${file}" text)
  split_lines("${text}" lines)
  set(hookCount 0)
  set(includeCount 0)
  foreach(line IN LISTS lines)
    if(line MATCHES "${qolInclude}")
      math(EXPR includeCount "${includeCount} + 1")
    elseif(line MATCHES "${qolUse}")
      math(EXPR hookCount "${hookCount} + 1")
      list(APPEND foundFiles "${relative}")
    endif()
  endforeach()
  if(includeCount GREATER 0 AND hookCount EQUAL 0)
    list(APPEND problems "${relative}: includes a src/qol header but has no hook line")
  endif()
endforeach()

set(allFiles ${listedFiles} ${foundFiles})
list(REMOVE_DUPLICATES allFiles)
foreach(relative IN LISTS allFiles)
  set(listedHere ${listedFiles})
  list(FILTER listedHere INCLUDE REGEX "^${relative}$")
  set(foundHere ${foundFiles})
  list(FILTER foundHere INCLUDE REGEX "^${relative}$")
  list(LENGTH listedHere listedHereCount)
  list(LENGTH foundHere foundHereCount)
  if(NOT listedHereCount EQUAL foundHereCount)
    list(APPEND problems "${relative}: ${foundHereCount} QoL hook line(s) in the file, ${listedHereCount} listed under 'Hook points' in docs/plans/features/qol-settings-menu-hooks.md")
  endif()
endforeach()

set(portHashes "")
set(portPaths "")
file(GLOB_RECURSE portFiles "${ROOT_DIR}/src/*.cpp" "${ROOT_DIR}/src/*.hpp" "${ROOT_DIR}/src/*.h")
set(qolSources "")
foreach(file IN LISTS portFiles)
  file(RELATIVE_PATH relative "${ROOT_DIR}" "${file}")
  if(relative MATCHES "^src/qol/")
    list(APPEND qolSources "${file}")
    continue()
  endif()
  file(SHA256 "${file}" hash)
  list(APPEND portHashes "${hash}")
  list(APPEND portPaths "${relative}")
endforeach()
foreach(file IN LISTS qolSources)
  file(SHA256 "${file}" hash)
  list(FIND portHashes "${hash}" index)
  if(NOT index EQUAL -1)
    list(GET portPaths ${index} copyOf)
    file(RELATIVE_PATH relative "${ROOT_DIR}" "${file}")
    list(APPEND problems "${relative}: identical copy of port file ${copyOf}")
  endif()
endforeach()

if(problems)
  string(REPLACE ";" "\n  " listing "${problems}")
  message(FATAL_ERROR "QoL separation violated:\n  ${listing}\nQoL identifiers (qol::, chase_qol) and src/qol includes belong only in src/qol/, tests/qol/ and the hook lines listed under 'Hook points' in docs/plans/features/qol-settings-menu-hooks.md; src/qol/ copies no port file (docs/rules/qol.md, rule qol-separation).")
endif()
